                }
              ]
            }
          }
        },
        {
          "name": "Get Leaderboard by Event and Year",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/:eventId/leaderboard?year=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", ":eventId", "leaderboard"],
              "query": [
                {
                  "key": "year",
                  "value": "2"
                }
              ],
              "variable": [
                {
                  "key": "eventId",
