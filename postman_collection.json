{
  "info": {
    "name": "Profile Data Handler API",
    "description": "Complete API collection for LeetCode Competition Profile Data Handler",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Get All Students (with filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?year=2&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [
                { "key": "year", "value": "2" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Student by Username",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/:username",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", ":username"],
              "variable": [
                {
                  "key": "username",
                  "value": "john_doe"
                }
              ]
            }
          }
        },
        {
          "name": "Get Students by Year",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/year/:year",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "year", ":year"],
              "variable": [
                {
                  "key": "year",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"name\": \"John Doe\",\n  \"enrollment\": \"12345\",\n  \"year\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Bulk Import Students",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"students\": [\n    {\n      \"username\": \"user1\",\n      \"name\": \"User One\",\n      \"enrollment\": \"E001\",\n      \"year\": 1\n    },\n    {\n      \"username\": \"user2\",\n      \"name\": \"User Two\",\n      \"enrollment\": \"E002\",\n      \"year\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/bulk-import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "bulk-import"]
            }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe Updated\",\n  \"year\": 3,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/:username",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", ":username"],
              "variable": [
                {
                  "key": "username",
                  "value": "john_doe"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Student (Soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/:username",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", ":username"],
              "variable": [
                {
                  "key": "username",
                  "value": "john_doe"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Student (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/:username/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", ":username", "permanent"],
              "variable": [
                {
                  "key": "username",
                  "value": "john_doe"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
