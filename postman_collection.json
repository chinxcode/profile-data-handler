          }
        },
        {
          "name": "Get Leaderboard by Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/:eventId/leaderboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", ":eventId", "leaderboard"],
              "variable": [
                {
                  "key": "eventId",
