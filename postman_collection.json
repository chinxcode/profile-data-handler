            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spring 2024 Competition\",\n  \"description\": \"Annual spring coding competition\",\n  \"startTime\": 1704067200000,\n  \"endTime\": 1709251200000,\n  \"years\": [1, 2, 3, 4],\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Event Name\",\n  \"description\": \"Updated description\",\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{eventId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Event (Soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{eventId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Event (Permanent)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/:id/permanent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", ":id", "permanent"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{eventId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Competition",
      "item": [
        {
          "name": "Update Competition Data (Legacy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/update-competition-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "update-competition-data"]
            }
          }
        },
        {
          "name": "Get Leaderboard (Legacy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaderboard-data"]
            }
          }
        },
        {
          "name": "Get Leaderboard by Year (Legacy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leaderboard-data?year=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaderboard-data"],
              "query": [
                {
                  "key": "year",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Update Competition Data by Event",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/:eventId/update-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", ":eventId", "update-data"],
              "variable": [
